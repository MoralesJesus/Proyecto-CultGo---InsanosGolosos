# Copia este archivo como .env y llena los valores
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=cultgo
DB_PORT=5433

# Proyecto de Firebase con el que se verifican los inicios de sesion
FIREBASE_PROJECT_ID=cultgo

# Correos que pueden crear/editar/eliminar eventos, separados por comas.
# Deben ser los mismos que frontend/src/config/admins.ts
ADMIN_CORREOS=
