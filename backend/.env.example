# Copia este archivo como .env y llena los valores
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=cultgo
DB_PORT=5433

# Proyecto de Firebase con el que se verifican los inicios de sesion
FIREBASE_PROJECT_ID=cultgo

# Correos que pueden crear/editar/eliminar eventos, separados por comas.
# Deben ser los mismos que frontend/src/config/admins.ts
ADMIN_CORREOS=

# Asistente con IA (formato de API de OpenAI). Por defecto usa Ollama en esta laptop.
# Ollama:  IA_URL=http://localhost:11434/v1   IA_MODELO=qwen2.5:7b   IA_CLAVE= (vacio)
# Groq:    IA_URL=https://api.groq.com/openai/v1   IA_MODELO=llama-3.3-70b-versatile   IA_CLAVE=gsk_...
# Gemini:  IA_URL=https://generativelanguage.googleapis.com/v1beta/openai   IA_MODELO=gemini-2.5-flash   IA_CLAVE=...
IA_URL=http://localhost:11434/v1
IA_MODELO=qwen2.5:7b
IA_CLAVE=
